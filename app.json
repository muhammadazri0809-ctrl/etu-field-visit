{
  "expo": {
    "name": "ETU Field Visit",
    "slug": "etu-field-visit",
    "owner": "azrizainals-team",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#F4F2EA",
    "android": {
      "package": "com.azrizainal.etufieldvisit",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2C5534"
      },
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-font",
      ["expo-image-picker", {
        "photosPermission": "Allow ETU Field Visit to attach photos to field findings.",
        "cameraPermission": "Allow ETU Field Visit to take photos of field findings."
      }],
      ["expo-splash-screen", {
        "image": "./assets/splash-icon.png",
        "imageWidth": 160,
        "resizeMode": "contain",
        "backgroundColor": "#F4F2EA"
      }]
    ],
    "extra": {
      "eas": { "projectId": "4c9b3d0b-18dd-4ca9-b372-c29be1b9d513" }
    }
  }
}
