{
  "expo": {
    "name": "ETU Field Visit",
    "slug": "etu-field-visit",
    "owner": "azrizainals-team",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#F8F6EE",
    "android": {
      "package": "com.azrizainal.etufieldvisit",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E3A2F"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ETU Field Visit to attach photos to field findings.",
          "cameraPermission": "Allow ETU Field Visit to take photos of field findings."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F8F6EE"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4c9b3d0b-18dd-4ca9-b372-c29be1b9d513"
      }
    }
  }
}
